{
  "manifest_version": 3,
  "name": "Outer Limit Project ",
  "version": "4.1",
  "description": "This is a chrome extension that a",
  "icons": {
    "48" : "icons/reddit.png",
    "128": "icons/reddit.png"
  },
  "author": "Chenchen Mao",
  "action": {
    "default_popup": "index.html",
    "default_title": "Reddit Extension"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://outerlimits.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://reddit.com/*",
        "https://reddit.com/*",
        "http://*.reddit.com/*",
        "https://*.reddit.com/*"
      ],
      "css": ["styles/hide.css"],
      "js": ["content_first.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://reddit.com/*",
        "https://reddit.com/*",
        "http://*.reddit.com/*",
        "https://*.reddit.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injectedScript.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
